# ============================================
# ZDL — Zheng Digital Lab
# Environment variables template
# Copy to .env (local) or set in Vercel dashboard
# ============================================

# --- Database ---
# Sandbox/lokal (SQLite):
DATABASE_URL="file:./db/custom.db"
# Produksi (Vercel + Postgres, mis. Neon/Supabase) — ganti provider di prisma/schema.prisma ke "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/zdl?schema=public"

# --- NextAuth (WAJIB diganti di produksi) ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-secret-acak-yang-panjang"
NEXTAUTH_URL="https://zdl.my.id"

# --- Site URL (SEO canonical & sitemap) ---
NEXT_PUBLIC_SITE_URL="https://zdl.my.id"

# --- Media upload produksi (opsional) ---
# Aktifkan Vercel Blob di project Vercel (Storage → Blob → connect),
# atau isi token secara manual untuk upload langsung ke Blob.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Seed admin (auto-seed saat build Vercel & prisma/seed.ts lokal) ---
ADMIN_EMAIL="admin@zdl.my.id"
ADMIN_PASSWORD="GantiPasswordIni2026!"
